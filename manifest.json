{
  "manifest_version": 3,
  "name": "LigaMagic Prices",
  "version": "1.15.0",
  "description": "Preços da LigaMagic.com.br em decks do Archidekt e no estoque da sua loja, por edição e arte exata.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.ligamagic.com.br/*",
    "https://api.scryfall.com/cards/*",
    "https://repositorio.sbrauble.com/*"
  ],
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://archidekt.com/*"
      ],
      "js": [
        "src/content/archidekt.js"
      ],
      "css": [
        "src/content/archidekt.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ligamagic.com.br/*"
      ],
      "js": [
        "src/content/ligamagic-import.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://tcg-data-base.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/content/estoque-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*"
      ],
      "matches": [
        "https://archidekt.com/*"
      ]
    }
  ],
  "options_page": "popup/popup.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "LigaMagic Prices",
    "default_icon": "assets/icons/icon48.png",
    "default_popup": "popup/popup.html"
  }
}
